# Version control
.git
.gitignore
.gitattributes
github

# Dependencies (reinstalled inside the image for the correct platform)
node_modules
vendor

# Local env & secrets (injected at runtime via compose env_file)
.env
.env.backup

# Build artifacts (regenerated by `npm run build`)
public/hot
public/build

# Editor / OS cruft
.DS_Store
**/.DS_Store
.idea
.vscode
.phpunit.result.cache

# Logs
npm-debug.log*
yarn-error.log*
