APP_NAME=DotPortal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
APP_DOMAIN=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (Postgres — container name `postgres` on the dotportal-development network)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dotportal
DB_USERNAME=dotportal
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local

CACHE_STORE=redis
CACHE_PREFIX=

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# Redis (container name `redis` on the dotportal-development network)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Horizon
HORIZON_PREFIX=dotportal_horizon:

# Broadcasting / Reverb
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST="localhost"
REVERB_PORT=9090
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Scout + Meilisearch (container name `meilisearch` on the dotportal-development network)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey
MEILI_ENV=development

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Authorize.Net API Credentials (https://developer.authorize.net/)
ANET_API_LOGIN_ID=
ANET_TRANSACTION_KEY=
ANET_PUBLIC_CLIENT_KEY=

# SAFERWEB API Key (https://saferwebapi.com/)
SAFERWEB_API_KEY=

# Transportation.gov open data app token (optional, raises rate limits)
TRANSPGOV_API_KEY=

# -----------------------------------------------------------------------------
# Third-party integrations (App\Mixins\Integrations + App\Services)
# NHTSA vPIC / Safety need no credentials (public, keyless).
# -----------------------------------------------------------------------------

# FMCSA QCMobile / SAFER (https://mobile.fmcsa.dot.gov/QCDevsite/)
FMCSA_WEB_KEY=

# Twilio SMS (https://www.twilio.com/)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Plaid (https://dashboard.plaid.com/)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Smarty / SmartyStreets US address validation (https://www.smarty.com/)
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=

# Motor Vehicle Records aggregator (e.g. SambaSafety) — paid, DPPA/FCRA
MVR_PROVIDER=sambasafety
MVR_BASE_URL=
MVR_API_KEY=

# FMCSA Drug & Alcohol Clearinghouse (via C/TPA partner — no open API)
CLEARINGHOUSE_BASE_URL=
CLEARINGHOUSE_API_KEY=

# FMCSA Pre-Employment Screening Program / PSP — paid, FCRA
PSP_BASE_URL=
PSP_ACCOUNT_ID=
PSP_API_KEY=

# DocuSign e-signature (https://developers.docusign.com/)
DOCUSIGN_BASE_URI=https://demo.docusign.net
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_ACCESS_TOKEN=

# OCR for CDL / medical card images (textract | documentai | custom)
OCR_PROVIDER=textract
OCR_BASE_URL=
OCR_API_KEY=

# Samsara ELD / telematics (https://developers.samsara.com/)
SAMSARA_API_TOKEN=
SAMSARA_BASE_URL=https://api.samsara.com

# -----------------------------------------------------------------------------
# Docker host bindings — consumed by compose.dev.yaml when running the stack
# -----------------------------------------------------------------------------
UID=1000
GID=1000

NGINX_PORT=8080
VITE_PORT=5173
REVERB_PORT=9090
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_COMMANDER_PORT=8081
ADMINER_PORT=9091
MEILISEARCH_PORT=7700

XDEBUG_ENABLED=true
XDEBUG_HOST=host.docker.internal
XDEBUG_IDE_KEY=DOCKER

# -----------------------------------------------------------------------------
# Production-only (compose.prod.registry.yaml)
# -----------------------------------------------------------------------------
# REGISTRY=ghcr.io/yourorg
# APP_VERSION=latest
